<%!-- Whitespace between tags is stripped after rendering (Site.Html.strip_whitespace_between_tags/1). --%>
<section class="rs">
  <div class="idn">
    <div>
      <h2><%= escape(@view.name) %></h2>
      <div class="tag"><%= @job_title %></div>
      <div class="links"><span><a href="<%= @view.linkedin.url %>"><%= @view.linkedin.label %></a></span> · <span><a href="<%= @view.github.url %>"><%= @view.github.label %></a></span></div>
      <div class="where"><%= escape(@view.location) %></div>
    </div>
    <a class="pv" href="<%= @pdf_path %>" download="<%= @pdf_download_name %>">
      <svg class="thumb" viewBox="0 0 155 136" aria-hidden="true"><use href="/assets/icons.svg#resume-page"/></svg>
      <span class="pl"><svg viewBox="0 0 24 24"><use href="/assets/icons.svg#download"/></svg>PDF</span>
      <span class="pt"><b><%= gettext("resume.download_pdf") %></b><small><%= gettext("resume.pdf_details") %></small></span>
      <span class="pd"><svg viewBox="0 0 24 24"><use href="/assets/icons.svg#download"/></svg></span>
    </a>
  </div>

  <h2><%= gettext("resume.summary") %></h2>
  <div class="sum">
    <%= for paragraph <- @view.summary do %>
      <p><%= escape(paragraph) %></p>
    <% end %>
  </div>

  <h2><%= gettext("resume.experience") %></h2>
  <div class="xp">
  <div class="tlm" role="navigation" aria-label="<%= gettext("resume.timeline") %>">
    <svg>
      <%= for company <- @view.timeline.companies do %>
        <a href="#<%= company.id %>" aria-label="<%= escape(company.name) %>, <%= company.period %>">
          <title><%= escape(company.name) %> · <%= company.period %></title>
          <%= if company.parallel do %><rect class="c<%= company.color %> par" x="<%= company.x %>%" y="3" width="<%= company.width %>%" height="6" rx="3"></rect><% else %><rect class="c<%= company.color %>" x="<%= company.x %>%" y="15" width="<%= company.width %>%" height="16" rx="3"></rect><% end %>
        </a>
      <% end %>
      <%= for tick <- @view.timeline.ticks do %>
        <text x="<%= tick.x %>%" y="44" text-anchor="<%= tick.anchor %>"><%= tick.label %></text>
      <% end %>
    </svg>
  </div>
  <div class="tl">
    <%= for experience <- @view.experiences do %>
      <div class="it" id="<%= experience.id %>">
        <div class="dot"></div>
        <a href="<%= experience.url %>">
          <%= if experience.acquired_by do %>
            <span class="lw">
              <img class="lo" src="/assets/images/logos/<%= experience.logo %>.png" alt="<%= escape(gettext("resume.logo_alt", name: experience.name)) %>" title="<%= escape(experience.name) %> · <%= escape(gettext("resume.acquired_by", company: experience.acquired_by)) %>">
              <span class="acq" role="img" aria-label="<%= escape(gettext("resume.acquired_by", company: experience.acquired_by)) %>" data-tip="<%= escape(gettext("resume.acquired_by", company: experience.acquired_by)) %>"><%= gettext("resume.acquired") %></span>
            </span>
          <% else %>
            <img class="lo" src="/assets/images/logos/<%= experience.logo %>.png" alt="<%= escape(gettext("resume.logo_alt", name: experience.name)) %>" title="<%= escape(experience.name) %>">
          <% end %>
        </a>
        <div class="rb">
          <div class="jh"><b><a href="<%= experience.url %>"><%= escape(experience.name) %></a></b><span><%= experience.period %></span></div>
          <div class="co"><a href="<%= experience.url %>" tabindex="-1"><%= escape(experience.location) %></a></div>
          <%= for role <- experience.roles do %>
            <div class="rl">
              <div class="jh">
                <i><%= escape(role.title) %></i>
                <%= if length(experience.roles) > 1 do %><span><%= role.period %></span><% end %>
              </div>
              <%= for paragraph <- role.paragraphs do %>
                <p><%= escape(paragraph) %></p>
              <% end %>
              <%= if role.bullets != [] do %>
                <ul>
                  <%= for bullet <- role.bullets do %>
                    <li><%= escape(bullet) %></li>
                  <% end %>
                </ul>
              <% end %>
              <%= for group <- role.references do %>
                <div class="cl">
                  <b><%= group.label %></b>
                  <div class="tiles">
                    <%= for reference <- group.items do %>
                      <span class="tile">
                        <%= if reference.url do %><a href="<%= reference.url %>"><% end %>
                        <img src="/assets/images/logos/<%= reference.logo %>.png" alt="<%= escape(reference.name) %>" title="<%= escape(reference.name) %><%= if reference.acquired_by do %> · <%= escape(gettext("resume.acquired_by", company: reference.acquired_by)) %><% end %>">
                        <%= if reference.url do %></a><% end %>
                        <%= if reference.acquired_by do %><span class="acq" role="img" aria-label="<%= escape(gettext("resume.acquired_by", company: reference.acquired_by)) %>" data-tip="<%= escape(gettext("resume.acquired_by", company: reference.acquired_by)) %>"><%= gettext("resume.acquired") %></span><% end %>
                      </span>
                    <% end %>
                  </div>
                </div>
              <% end %>
              <%= if role.stack != [] do %>
                <div class="cl stk">
                  <b><%= gettext("resume.stack") %></b>
                  <div class="chips">
                    <%= for item <- role.stack do %>
                      <span><%= escape(item) %></span>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
  </div>

  <h2><%= gettext("resume.education") %></h2>
  <%= for education <- @view.educations do %>
    <div class="ed">
      <b>
        <a href="<%= education.url %>" title="<%= escape(education.school) %>"><%= escape(education.name) %><%= if education.closed_in do %><span class="closed" role="img" data-tip="<%= gettext("resume.closed_in", year: education.closed_in) %>" aria-label="<%= gettext("resume.closed_in", year: education.closed_in) %>"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="/assets/icons.svg#info"/></svg></span><% end %></a>
      </b>
      <span><%= escape(education.degree) %></span>
      <span><%= education.period %></span>
    </div>
  <% end %>

  <h2><%= gettext("resume.skills") %></h2>
  <%= for skill <- @view.skills do %>
    <div class="sk">
      <b><%= skill.label %></b>
      <div class="chips">
        <%= for item <- skill.items do %>
          <span><%= escape(item) %></span>
        <% end %>
      </div>
    </div>
  <% end %>

  <%= if @view.recommendations != [] do %>
    <h2 id="recommendations"><%= gettext("resume.recommendations") %></h2>
    <%!-- Two columns: the first two recommendations, then the rest; the cards stretch so both columns end level --%>
    <div class="rcs">
      <%= for column <- Tuple.to_list(Enum.split(@view.recommendations, 2)), column != [] do %>
        <div class="rcc">
          <%= for recommendation <- column do %>
            <figure class="rc">
              <figcaption>
                <%= if recommendation.photo do %>
                  <img class="av" src="<%= recommendation.photo %>" alt="" loading="lazy">
                <% else %>
                  <span class="av" aria-hidden="true"><%= escape(recommendation.initials) %></span>
                <% end %>
                <a class="who" href="<%= recommendation.url %>"<%= if recommendation.headline do %> title="<%= escape(recommendation.headline) %>"<% end %>>
                  <b><%= escape(recommendation.name) %></b>
                  <small><%= escape(recommendation.context) %></small>
                </a>
              </figcaption>
              <%= if recommendation.highlight do %>
                <div class="rq">
                  <p class="pull" lang="en"><%= if recommendation.omitted.before do %><span class="om">…</span><% end %><%= escape(recommendation.highlight) %><%= if recommendation.omitted.after do %><span class="om">…</span><% end %></p>
                  <details name="recommendations">
                    <summary><span class="rd-more"><%= gettext("resume.read_full") %></span><span class="rd-less"><%= gettext("resume.show_less") %></span></summary>
                    <blockquote lang="en">
                      <%= for paragraph <- recommendation.paragraphs do %>
                        <p><%= mark(paragraph, recommendation.highlight) %></p>
                      <% end %>
                    </blockquote>
                  </details>
                </div>
              <% else %>
                <blockquote lang="en">
                  <%= for paragraph <- recommendation.paragraphs do %>
                    <p><%= escape(paragraph) %></p>
                  <% end %>
                </blockquote>
              <% end %>
            </figure>
          <% end %>
        </div>
      <% end %>
    </div>
    <p class="all"><a href="<%= @view.all_recommendations_url %>"><%= gettext("resume.all_recommendations") %></a></p>
  <% end %>

  <h2 id="languages"><%= gettext("resume.languages") %></h2>
  <div class="chips lg">
    <%= for language <- @view.languages do %>
      <span><%= escape(language) %></span>
    <% end %>
  </div>
</section>
