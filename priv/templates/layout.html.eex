<!DOCTYPE html>
<html lang="<%= @lang %>">

<head>
  <!-- Analytics (production only - won't fire on file:// or localhost) -->
  <script async src="https://plausible.io/js/pa-nAUxwgQ1pudq_MQWBj_iS.js"></script>
  <script async src="/assets/js/analytics.js"></script>

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title><%= @title %></title>
  <meta name="description" content="<%= @description %>" />
  <meta name="author" content="raulpe7eira" />

  <!-- Open Graph -->
  <meta property="og:type" content="<%= @og_type %>" />
  <meta property="og:title" content="<%= @title %>" />
  <meta property="og:description" content="<%= @description %>" />
  <meta property="og:image" content="https://raulpe7eira.tech/assets/images/og-image.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:alt" content="Raul Pereira (raulpe7eira) – <%= @job_title %>" />
  <meta property="og:url" content="<%= @url %>" />
  <meta property="og:site_name" content="raulpe7eira" />
  <meta property="og:locale" content="<%= @og_locale %>" />
  <meta property="og:locale:alternate" content="<%= @og_locale_alternate %>" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= @title %>" />
  <meta name="twitter:description" content="<%= @description %>" />
  <meta name="twitter:image" content="https://raulpe7eira.tech/assets/images/og-image.jpg" />
  <meta name="twitter:image:alt" content="Raul Pereira (raulpe7eira) – <%= @job_title %>" />

  <!-- Canonical -->
  <link rel="canonical" href="<%= @url %>" />
  <link rel="alternate" hreflang="en-US" href="<%= @url_en_us %>" />
  <link rel="alternate" hreflang="pt-BR" href="<%= @url_pt_br %>" />
  <link rel="alternate" hreflang="x-default" href="<%= @url_en_us %>" />

  <!-- Favicons -->
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" type="image/svg+xml" href="/assets/images/icons/favicon.svg" />
  <link rel="icon" type="image/png" href="/assets/images/icons/favicon-96x96.png" sizes="96x96" />
  <link rel="apple-touch-icon" href="/assets/images/icons/apple-touch-icon.png" />
  <link rel="manifest" href="/assets/images/icons/manifest.webmanifest" />
  <meta name="apple-mobile-web-app-title" content="raulpe7eira.tech" />
  <meta name="theme-color" content="#282a36" />

  <!-- JSON-LD Structured Data -->
<%= @jsonld %>

  <!-- Fonts (self-hosted, declared in base.css) -->
  <link rel="preload" href="/assets/fonts/inter-regular.woff2" as="font" type="font/woff2" crossorigin />

  <script>try{var t=localStorage.getItem("theme");if(t)document.documentElement.dataset.theme=t}catch(e){}</script>
  <link rel="stylesheet" href="/assets/css/base.css" />
<%= @extra_head %></head>

<body>
  <div class="hero" aria-hidden="true"></div>

  <main>
    <div class="toolbar">
      <a <%= @page_btn_attrs %>><%= @page_btn_label %><span class="sw" aria-hidden="true"></span></a>
      <a class="lang-btn" href="<%= @switch_href %>" hreflang="<%= @switch_lang %>" lang="<%= @switch_lang %>" aria-label="<%= @switch_label %>" title="<%= @switch_label %>"><%= @lang_code %></a>
      <div class="theme-wrap">
        <button class="theme-btn" aria-label="Change theme" title="Change theme">
          <svg viewBox="0 0 24 24"><use href="/assets/icons.svg#palette"/></svg>
        </button>
        <div id="theme-panel" class="theme-panel" hidden>
          <button data-theme="dracula"><span class="theme-dot"></span>Dracula</button>
          <button data-theme="nord"><span class="theme-dot"></span>Nord</button>
          <button data-theme="gruvbox"><span class="theme-dot"></span>Gruvbox</button>
          <button data-theme="catppuccin"><span class="theme-dot"></span>Catppuccin</button>
          <button data-theme="solarized"><span class="theme-dot"></span>Solarized</button>
          <button data-theme="tokyonight"><span class="theme-dot"></span>Tokyo Night</button>
          <button data-theme="rosepine"><span class="theme-dot"></span>Rose Pine</button>
          <button data-theme="onedark"><span class="theme-dot"></span>One Dark</button>
          <button data-theme="dark"><span class="theme-dot"></span>Dark</button>
        </div>
      </div>
    </div>
    <header class="profile">
      <a class="profile-link" href="<%= @home_path %>" title="raulpe7eira.tech">
      <span class="avatar-wrap"><img class="avatar" src="/assets/images/avatar.jpg" alt="<%= @avatar_alt %>" width="120" height="120" /></span>
      <div class="title-container">
        <h1>raulpe7eira</h1>
        <p class="subtitle" id="subtitle-<%= @lang_key %>"><%= @subtitle %></p>
      </div>
      </a>
    </header>

<%= @content %>

    <footer>
      <p id="footer-<%= @lang_key %>"><a href="https://r3m.tech" target="_blank" rel="noopener noreferrer" aria-label="R3M Tech"><%= @made_with %> <span class="heart">&hearts;</span> <%= @by %> <span class="r3m">R3M</span> <span class="tech">TECH</span></a></p>
    </footer>
  </main>

  <script defer src="/assets/js/theme.js"></script>
  <script defer src="/assets/js/nav.js"></script>
</body>

</html>
