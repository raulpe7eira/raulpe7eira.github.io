  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Person",
        "@id": "<%= @home_url %>#person",
        "name": "Raul Pereira",
        "alternateName": "raulpe7eira",
        "url": "<%= @home_url %>",
        "image": "<%= @base_url %>/assets/images/icons/icon-512.png",
        "jobTitle": "<%= @job_title %>",
        "worksFor": { "@type": "Organization", "name": "R3M Tech", "url": "https://r3m.tech/" },
        "description": "<%= @description %>",
        "knowsAbout": ["Elixir", "Phoenix", "AI", "Kotlin", "Java", "JavaScript"],
        "alumniOf": [
          { "@type": "CollegeOrUniversity", "name": "PUC-Rio" },
          { "@type": "CollegeOrUniversity", "name": "UniverCidade" }
        ],
        "sameAs": [
          "https://github.com/raulpe7eira",
          "https://linkedin.com/in/raulpe7eira",
          "https://x.com/raulpe7eira",
          "https://bsky.app/profile/raulpe7eira.tech",
          "https://instagram.com/raulpe7eira",
          "https://facebook.com/raulpe7eira",
          "https://strava.com/athletes/raulpe7eira",
          "https://imdb.com/user/ur28106453",
          "https://last.fm/user/raulpereira"
        ]
      },
      {
        "@type": "WebSite",
        "@id": "<%= @home_url %>#website",
        "url": "<%= @home_url %>",
        "name": "raulpe7eira",
        "inLanguage": <%= @languages %>,
        "publisher": { "@id": "<%= @home_url %>#person" }
      }
    ]
  }
  </script>
